{
  "manifest_version": 3,
  "name": "PhishBrake",
  "description": "Scan suspicious text with the local PhishBrake safety engine.",
  "version": "0.1.0",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:7860/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Scan with PhishBrake",
    "default_popup": "index.html"
  }
}
